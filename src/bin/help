#!/usr/bin/env bash
# help — uniform overview: status, settings, commands. Replaces env-wrapper --help.
: "${SNAP:?SNAP must be set}"
source "$SNAP/helper/functions"
source "$SNAP/helper/ui"
source "$SNAP/helper/catalog"

settings_rows() {              # catalog (common only) + live values -> TSV: key, value, default, description
    local key type def desc scope applies cur
    # shellcheck disable=SC2034  # applies is unused here
    while IFS=$'\t' read -r key type def desc scope applies; do
        [ "$scope" = common ] || continue           # advanced keys stay out of the help table
        cur="$(snapctl get "$key" 2>/dev/null)"
        [ "$type" = secret ] && [ -n "$cur" ] && cur="(hidden)"
        if [ "$key" = session.cookie-secure ] && [ -z "$cur" ]; then
            # the effective HTTPS (web_ui_url's scheme: ssl=true and not force-disabled), like env-wrapper
            case "$(web_ui_url)" in https:*) cur="(follows server.ssl: true)" ;; *) cur="(follows server.ssl: false)" ;; esac
        fi
        printf '%s\t%s\t%s\t%s\n' "$key" "${cur:-(unset)}" "$def" "$desc"
    done < <(settings_catalog)
}

commands_rows() {
    printf '%s\n' \
        "sudo $SNAP_NAME.enable	start the service now and at every boot" \
        "sudo $SNAP_NAME.disable	stop it and do not start at boot" \
        "sudo $SNAP_NAME.restart	restart the service" \
        "sudo $SNAP_NAME.exec	run in the foreground (debug start-up)" \
        "sudo $SNAP_NAME.ui	interactive navigator — settings, service, interfaces, logs" \
        "sudo $SNAP_NAME.logs [zui|zwjs]	follow live logs (merged by default)" \
        "$SNAP_NAME.backup ...	ship backups off-box (see --help; most need sudo)" \
        "$SNAP_NAME.help	this overview (no sudo)"
}

main() {
    plugs_connected || ui_warn "Required interfaces are not connected — see the connect instructions above."
    ui_header "$SNAP_NAME" "$(snap_version) · $(service_state)"
    echo
    case "$(service_state)" in
        *" active") ui_print "Running — web UI: $(web_ui_url)   stop: sudo $SNAP_NAME.disable" ;;
        "enabled inactive") ui_print "Enabled but not running — see: sudo $SNAP_NAME.logs" ;;
        *)
            ui_print "The daemon is DISABLED by default after install. Enable it with:"
            ui_print "  sudo $SNAP_NAME.enable" ;;
    esac
    echo
    settings_rows | ui_table "setting" "value" "default" "description"
    echo
    ui_print "Set options with:  sudo snap set $SNAP_NAME <key>=<value>"
    ui_print "Other settings live in the web UI after start."
    echo
    commands_rows | ui_table "command" "description"
    echo
    ui_print "serial-port plug (needs snapd's experimental hotplug):"
    ui_print "  sudo snap set system experimental.hotplug=true && sudo systemctl restart snapd"
    ui_print "  sudo snap interface serial-port            # list available slots"
    ui_print "  sudo snap connect $SNAP_NAME:serial-port <slot name>"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    # main renders styled (UI_TTY1 is cached at source time, so the internal pipe to
    # ui_pager does not flip the context to plain); ui_pager scrolls only on overflow.
    main "$@" | ui_pager
fi
