#!/usr/bin/env bash
# ui — interactive navigator: browse & act on settings, service, plugs, logs.
: "${SNAP:?SNAP must be set}"
source "$SNAP/helper/functions"
source "$SNAP/helper/ui"
source "$SNAP/helper/catalog"

# --- section stubs (replaced in Tasks 2-5) ---
nav_settings() {               # browse the catalog; edit via snapctl (nav_set_apply validates + re-seeds + offers restart,
                               # because snapd skips the configure hook for in-app snapctl writes)
    local choice key type def desc cur raw act new
    while true; do
        ui_clear
        # build the key list with current values inline (Back first; the choose list filters as you type)
        local items=() k v
        while IFS= read -r k; do
            v="$(snapctl get "$k" 2>/dev/null)"; catalog_is_secret "$k" && [ -n "$v" ] && v="(hidden)"
            items+=("$k = ${v:-(unset)}")
        done < <(catalog_keys)
        choice="$(ui_choose "Setting" "" "← Back" "${items[@]}")" || return
        [ "$choice" = "← Back" ] && return
        key="${choice%% = *}"
        type="$(catalog_field "$key" 2)"; def="$(catalog_field "$key" 3)"; desc="$(catalog_field "$key" 4)"
        cur="$(snapctl get "$key" 2>/dev/null)"; raw="$cur"; catalog_is_secret "$key" && [ -n "$cur" ] && cur="(hidden)"
        ui_kv "key" "$key" "current" "${cur:-(unset)}" "default" "$def" "type" "$type" "description" "$desc"
        act="$(ui_choose "Action for $key" "" "← Back" "Edit" "Reset to default")" || continue
        case "$act" in
            Edit)
                if [ "$type" = bool ]; then
                    new="$(ui_choose --selected "$raw" "$key =" "" "true" "false")" || continue
                else
                    if catalog_is_secret "$key"; then
                        new="$(ui_input --password "$key = ")" || continue
                    else
                        new="$(ui_input --value "$raw" "$key = ")" || continue
                    fi
                fi
                nav_set_apply "$key" "$new" set ;;
            "Reset to default") nav_set_apply "$key" "" unset ;;
            *) : ;;
        esac
    done
}

nav_set_apply() {              # $1 key, $2 value, $3 set|unset. snapd commits in-app snapctl writes WITHOUT running
                               # the configure hook, so do its job here: validate, re-seed a reset, offer a restart.
    local key="$1" val="$2" mode="$3" msg shown applies
    [ "$mode" = set ] && [ -z "$val" ] && mode="unset"
    if [ "$mode" = set ]; then
        if ! msg="$(validate_config "$key" "$val" 2>&1)"; then
            ui_err "Rejected — $key unchanged"
            [ -n "$msg" ] && ui_print "$msg"
            ui_pause
            return
        fi
        if ! msg="$(validate_cross_config "$key" "$val" 2>&1)"; then
            ui_err "Rejected — $key unchanged"
            [ -n "$msg" ] && ui_print "$msg"
            ui_pause
            return
        fi
        snapctl set "$key=$val" || { ui_err "snapctl could not set $key"; ui_pause; return; }
        shown="$val"; catalog_is_secret "$key" && shown="(hidden)"
        ui_ok "$key set to $shown"
    else
        snapctl unset "$key" || { ui_err "snapctl could not unset $key"; ui_pause; return; }
        ( test_default_config ) >/dev/null 2>&1     # subshell: its testnset_config exits on a failed set
        shown="$(snapctl get "$key" 2>/dev/null)"
        catalog_is_secret "$key" && [ -n "$shown" ] && shown="(hidden)"
        # Nothing stored: the default applies at run time (backup.retention, …) — show it.
        [ -n "$shown" ] || shown="$(catalog_field "$key" 3)"
        ui_ok "$key reset to default: ${shown:-(unset)}"
    fi
    applies="$(catalog_field "$key" 6)"
    case "$applies" in
        daemon)
            case "$(service_state)" in
                *" active") if ui_confirm "Restart $SNAP_NAME to apply?"; then "${NAV_BIN:-$SNAP/bin}/restart"; fi ;;
                *) ui_print "Takes effect when the service starts." ;;
            esac ;;
        backup) ui_print "Used by the next backup run." ;;
    esac
    ui_pause
}

nav_service() {                # browse status; act via the existing service bins
    local bindir="${NAV_BIN:-$SNAP/bin}" choice
    while true; do
        ui_clear
        ui_kv "service" "$SNAP_NAME" "state" "$(service_state)"
        choice="$(ui_choose "Service action" "" "← Back" "Enable" "Disable" "Restart")" || return
        case "$choice" in
            Enable)  "$bindir/daemonize" ;;
            Disable) "$bindir/de-daemonize" ;;
            Restart) "$bindir/restart" ;;
            *)       return ;;
        esac
        ui_pause
    done
}
nav_plugs() {                  # browse interface status; guide the connect commands (never auto-connect)
    # plug -> purpose (the connect-relevant interfaces)
    local catalog="hardware-observe	required — detects the controller; pair with raw-usb or serial-port
raw-usb	USB Z-Wave stick access
serial-port	serial Z-Wave stick (needs experimental hotplug)
log-observe	read journald logs when 'log to file' is off
gpg-public-keys	the backup key picker"
    local choice plug purpose
    while true; do
        ui_clear
        local items=() p rest mark
        while IFS=$'\t' read -r p rest; do
            snapctl is-connected "$p" 2>/dev/null && mark="✓" || mark="✗"
            items+=("$mark $p")
        done <<< "$catalog"
        choice="$(ui_choose "Interface (✓ connected)" "" "← Back" "${items[@]}")" || return
        [ "$choice" = "← Back" ] && return
        plug="${choice#* }"
        purpose="$(printf '%s\n' "$catalog" | awk -F'\t' -v k="$plug" '$1==k{print $2}')"
        ui_kv "plug" "$plug" "purpose" "$purpose"
        if snapctl is-connected "$plug" 2>/dev/null; then
            ui_ok "$plug is connected."
        else
            ui_warn "$plug is not connected. Connect it from the host:"
            ui_print "  sudo snap connect $SNAP_NAME:$plug"
            [ "$plug" = serial-port ] && ui_print "  (first: sudo snap set system experimental.hotplug=true && sudo systemctl restart snapd)"
        fi
        ui_pause
    done
}
nav_logs() {                   # choose a stream, hand off to the existing logs viewer
    local bindir="${NAV_BIN:-$SNAP/bin}" sel
    sel="$(ui_choose "Follow which logs?" "" "← Back" "all" "zui" "zwjs")" || return
    [ "$sel" = "← Back" ] && return
    "$bindir/logs" "$sel"
}

nav_help() { "${NAV_BIN:-$SNAP/bin}/help"; }

mqtt_file() { printf '%s\n' "${SNAP_DATA}/settings.json"; }

mqtt_get() {                   # $1 mqtt.<field> -> current value or empty
    local f v; f="$(mqtt_file)"; [ -f "$f" ] || { echo ""; return; }
    v="$(yq -p=json -r ".$1" "$f" 2>/dev/null)"; [ "$v" = null ] && v=""
    printf '%s\n' "$v"
}

mqtt_set() {                   # $1 mqtt.<field>, $2 value, $3 type -> atomic write; rc 1 on failure
    local path="$1" val="$2" type="$3" f tmp expr
    f="$(mqtt_file)"; [ -f "$f" ] || echo '{}' > "$f"
    case "$type" in
        int)  expr=".$path = (strenv(V) | tonumber)" ;;
        bool) expr=".$path = (strenv(V) == \"true\")" ;;
        *)    expr=".$path = strenv(V)" ;;
    esac
    tmp="$(mktemp "${f}.XXXX")"
    if V="$val" yq -p=json -o=json "$expr" "$f" > "$tmp" 2>/dev/null && yq -p=json '.' "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$f"; return 0
    fi
    rm -f "$tmp"; return 1
}

nav_mqtt() {                   # edit the MQTT broker connection in settings.json (no env var for these)
    local fields="mqtt.host	string
mqtt.port	int
mqtt.auth	bool
mqtt.username	string
mqtt.password	secret"
    local choice path type cur new running
    while true; do
        ui_clear
        running=0; case "$(service_state)" in *" active") running=1 ;; esac
        [ "$running" = 1 ] && ui_warn "Editing settings.json. If the daemon is running it may overwrite changes on its own saves."
        local items=() p t v
        while IFS=$'\t' read -r p t; do
            v="$(mqtt_get "$p")"; [ "$t" = secret ] && [ -n "$v" ] && v="(hidden)"
            items+=("$p = ${v:-(unset)}")
        done <<< "$fields"
        choice="$(ui_choose "MQTT broker (settings.json)" "" "← Back" "${items[@]}")" || return
        [ "$choice" = "← Back" ] && return
        path="${choice%% = *}"
        type="$(printf '%s\n' "$fields" | awk -F'\t' -v k="$path" '$1==k{print $2}')"
        if [ "$type" = bool ]; then new="$(ui_choose "$path =" "" "true" "false")" || continue
        elif [ "$type" = secret ]; then new="$(ui_input --password "$path = ")" || continue
        else new="$(ui_input "$path = ")" || continue; fi
        if mqtt_set "$path" "$new" "$type"; then
            local shown="$new"; [ "$type" = secret ] && [ -n "$new" ] && shown="(hidden)"
            ui_ok "$path set to $shown"
            if [ "$running" = 1 ]; then
                if ui_confirm "Restart $SNAP_NAME to apply?"; then "${NAV_BIN:-$SNAP/bin}/restart"; fi
            else
                ui_print "Takes effect when the service starts."
            fi
        else
            ui_err "Could not write $path — settings.json unchanged"
        fi
        ui_pause
    done
}

main() {
    require_root
    if [ "${TERM:-}" = dumb ]; then
        ui_print "$SNAP_NAME.ui needs a terminal that can draw menus (TERM=dumb) — use the $SNAP_NAME.* commands, or run with a different TERM" >&2
        return 2
    fi
    if ! ui_interactive; then
        ui_print "$SNAP_NAME.ui needs an interactive terminal — see $SNAP_NAME.help" >&2
        return 2
    fi
    local choice
    while true; do
        ui_clear
        ui_header "$SNAP_NAME" "$(snap_version) · $(service_state)"
        choice="$(ui_choose "What do you want to do?" \
            "this menu needs a terminal; use the other $SNAP_NAME.* commands non-interactively" \
            "Settings" "Service" "Plugs" "Live logs" "MQTT broker" "Help" "Quit")" || break
        case "$choice" in
            Settings)      nav_settings ;;
            Service)       nav_service ;;
            Plugs)         nav_plugs ;;
            "Live logs")   nav_logs ;;
            "MQTT broker") nav_mqtt ;;
            Help)          nav_help ;;
            Quit|"")       break ;;
        esac
    done
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
