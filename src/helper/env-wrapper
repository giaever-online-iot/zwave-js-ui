#!/usr/bin/env bash

source "$SNAP/helper/functions"
source "$SNAP/helper/catalog"

require_root

plugs_connected || exit 1


HOST=$(snapctl get server.host); export HOST
PORT=$(snapctl get server.port); export PORT

SERVER_SSL=$(snapctl get server.ssl); export SERVER_SSL
export HTTPS="${SERVER_SSL}"

FORCE_DISABLE_SSL=$(snapctl get server.force-disable-ssl); export FORCE_DISABLE_SSL

if [ "${FORCE_DISABLE_SSL}" != true ]; then
    unset FORCE_DISABLE_SSL
fi

# session.cookie-secure unset = follow the effective HTTPS; only an explicit false opts out.
COOKIE_CFG=$(snapctl get session.cookie-secure)

if [ "${HTTPS}" != true ] || [ "${FORCE_DISABLE_SSL}" == true ]; then
    unset HTTPS
    unset SERVER_SSL
    unset USE_SECURE_COOKIE
elif [ "${COOKIE_CFG}" = true ] || [ -z "${COOKIE_CFG}" ]; then
    export USE_SECURE_COOKIE=true
else
    unset USE_SECURE_COOKIE
fi
unset COOKIE_CFG

SESSION_SECRET=$(snapctl get session.secret)
if [ -n "${SESSION_SECRET}" ]; then
    export SESSION_SECRET
else
    unset SESSION_SECRET
fi

MQTT_NAME=$(snapctl get mqtt.name); export MQTT_NAME

if [ -z "${MQTT_NAME}" ]; then
    unset MQTT_NAME
fi

# zwave.* (advanced snap config) -> ZUI env vars. Omit when empty so an unset
# snap key never force-blanks a value configured elsewhere (the MQTT_NAME pattern).
zwave_env() {                  # $1 snap key, $2 env var name
    local v; v="$(snapctl get "$1")"
    [ -n "$v" ] && export "$2"="$v"
}
zwave_env zwave.serial-port            ZWAVE_PORT
zwave_env zwave.s2-unauthenticated     KEY_S2_Unauthenticated
zwave_env zwave.s2-authenticated       KEY_S2_Authenticated
zwave_env zwave.s2-access-control      KEY_S2_AccessControl
zwave_env zwave.s2-lr-authenticated    KEY_LR_S2_Authenticated
zwave_env zwave.s2-lr-access-control   KEY_LR_S2_AccessControl
zwave_env zwave.s0-legacy              KEY_S0_Legacy

if [ -n "$(snapctl get timezone)" ]; then
    TZ=$(snapctl get timezone); export TZ
fi

export ZWAVEJS_LOGS_DIR="${STORE_DIR}/logs/zwavejs"
BACKUPS_DIR="$(backup_dir)"; export BACKUPS_DIR

# Record the config this daemon starts with; the configure hook restarts the
# service only when the digest changes (not on refresh, not for backup-only keys).
# Only the daemon records it (DAEMONIZED=1 is set by the daemon app alone): `exec`
# runs this wrapper too, and its config is not what the running daemon has.
# Compute first, then replace atomically (tmp + mv): the hook may read the file while
# this runs, and a truncated or empty file would read as "changed" and restart again.
if [ "${DAEMONIZED:-0}" = 1 ]; then
    DIGEST_FILE="$(daemon_digest_file)"
    DIGEST="$(daemon_config_digest 2>/dev/null)"
    if ! [[ "$DIGEST" =~ ^[0-9a-f]{64}$ ]] \
        || ! ( umask 077; printf '%s\n' "$DIGEST" > "${DIGEST_FILE}.tmp" ) 2>/dev/null \
        || ! chmod 600 "${DIGEST_FILE}.tmp" 2>/dev/null \
        || ! mv -f "${DIGEST_FILE}.tmp" "$DIGEST_FILE" 2>/dev/null; then
        rm -f "${DIGEST_FILE}.tmp" 2>/dev/null
        lprint "Could not record the config digest in ${DIGEST_FILE}"
    fi
    unset DIGEST DIGEST_FILE
fi

# When chained ahead of `npm`, run it from the app's module dir so its subcommands
# resolve; otherwise exec the target as-is. Explicit if/then avoids the `A && B || C`
# pitfall where a failed `cd` would silently fall through to an un-chdir'd exec.
if [ "$(basename "${1}")" = "npm" ]; then
    cd "${SNAP}/lib/node_modules/zwave-js-ui" || exit 1
fi
exec "${@}"
