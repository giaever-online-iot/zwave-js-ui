#!/usr/bin/env bash

export ZWAVE_JS_CONF="${SNAP}/lib/node_modules/zwave-js-ui/node_modules/@zwave-js/config"

if [ -z "${DAEMONIZED:-}" ]; then
    DAEMONIZED=0
fi

function lprint {
    if [ "${DAEMONIZED}" -eq 0 ]; then
        echo "${1}"
    else
        logger "${SNAP_NAME}: ${1}"
    fi
}

function plug_connected {
    if ! snapctl is-connected "${1}"; then
        lprint "Missing interface: ${1}"
        lprint "Connect with:"
        if [ "${1}" == "serial-port" ]; then
            lprint "sudo snap connect ${SNAP_NAME}:${1} <slot name>"
        else
            lprint "sudo snap connect ${SNAP_NAME}:${1}"
        fi
        return 1
    fi
    return 0
}

function plugs_connected {
    MISSING=0

    RAW_OUT=$(DAEMONIZED=0 plug_connected "raw-usb")
    RAW_RES=$?

    SERIAL_OUT=$(DAEMONIZED=0 plug_connected "serial-port")
    SERIAL_RES=$?

    if [ "$RAW_RES" -ne 0 ] && [ "$SERIAL_RES" -ne 0 ]; then
        lprint "Connect raw-usb (USB stick) OR serial-port (see ${SNAP_NAME}.help):"
        lprint "$RAW_OUT"
        lprint "$SERIAL_OUT"
        MISSING=1
    fi

    plug_connected "hardware-observe" || MISSING=1

    if [ $MISSING -ne 0 ]; then
        return 1
    fi

    return 0
}

function require_root {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        lprint "${SNAP_NAME}: this command must run as root — re-run with sudo." >&2
        exit 1
    fi
}

function testnset_config {
    # Hooks run with DAEMONIZED=1, so these lprints land in syslog — never log
    # secret values (session.secret would end up world-readable in the journal).
    local shown="${2}"
    case "${1}" in *secret*) shown="(redacted)" ;; esac
    lprint "Testing ${1}, or setting ${shown}"
    RES=$(snapctl get ${1})
    if [ $? -ne 0 ] || [ -z "${RES}" ]; then
        lprint "Setting ${1}=${shown}"
        RES=$(snapctl set ${1}=${2})
        if [ $? -ne 0 ]; then
            lprint "${RES}"
            exit 1
        fi
        return 0
    fi
    return 0
}

function zui_settings_file {
    realpath -e "${SNAP_DATA}/settings.json" 2>&- | test_perm "${1}"
}

function test_perm {
    read -r F
    echo "${F}"
    test "-${1:-r}" "${F}"
}

function set_device_priority_dir {
    lprint ".zwave.deviceConfigPriorityDir: «${1:-None}»"
    DEV_DIR="${1}" yq -i '.zwave.deviceConfigPriorityDir = strenv(DEV_DIR)' "${2:-"$(zui_settings_file "w")"}" && return $?
}

function test_device_priority_dir {
    # snapd copies $SNAP_DATA forward on every refresh, so settings.json is carried
    # between revisions automatically — this function does NOT move config. Its only
    # job is to rewrite a stale, revision-pinned deviceConfigPriorityDir (see below).
    # If there's no settings.json yet (fresh install, or ZUI never started), there is
    # nothing to migrate: no-op instead of aborting the hook with exit 1.
    if ! ZUI_SETTINGS=$(zui_settings_file "w"); then
        lprint "No writable settings.json yet; skipping deviceConfigPriorityDir migration."
        return 0
    fi

    DEV_DIR=$(yq -r '.zwave.deviceConfigPriorityDir // ""' "${ZUI_SETTINGS}" 2>&-)
    [ -n "${DEV_DIR}" ] || return 0
    NDEV_DIR=${DEV_DIR}

    if [[ "${DEV_DIR}" =~ ^"$(dirname ${SNAP_DATA})" ]]; then
        # escape ERE metacharacters in the parent path (a "+" in it would act as a quantifier)
        SNAP_PARENT=$(dirname "${SNAP_DATA}" | sed 's/[][\.*^$+?(){}|#]/\\&/g')
        NDEV_DIR=$(sed -E "s#${SNAP_PARENT}/(current|x?[0-9]+)#${SNAP_DATA}#g" <<< "${DEV_DIR}")
    fi

    if [ -d "${NDEV_DIR}" ] && [ -r "${NDEV_DIR}" ]; then
        if [ "${NDEV_DIR}" != "${DEV_DIR}" ]; then
            set_device_priority_dir "${NDEV_DIR}" "${ZUI_SETTINGS}" || return $?
        fi
    elif [ ! -r "${NDEV_DIR}" ]; then
        set_device_priority_dir "" "${ZUI_SETTINGS}" || return $?
    fi

    if [ -n "${NDEV_DIR}" ] && [ ! -w "${NDEV_DIR}" ]; then
        lprint ".zwave.deviceConfigPriorityDir not writable: ${NDEV_DIR}"
    fi
    
    return 0
}

function test_default_config {
    testnset_config "server.host" "0.0.0.0"
    testnset_config "server.port" 8091

    testnset_config "server.ssl" false
    testnset_config "server.force-disable-ssl" false

    # session.cookie-secure and timezone are not seeded: unset means "follows server.ssl"
    # (env-wrapper) and "the host's zone" (D5, D6).

    testnset_config "mqtt.name" ""
}

# Older revisions seeded session.secret with a v1 UUID, which overrode the
# app's own 256-bit secret. Drop that value (and only that shape) so the app
# keeps its own — once: the marker file stops later refreshes from removing a
# v1 UUID the user sets on purpose. Never prints the value.
function migrate_session_secret {
    local marker="${SNAP_COMMON}/.session-secret-migrated" v
    [ -e "$marker" ] && return 0
    v="$(snapctl get session.secret 2>/dev/null)"
    if [ "${#v}" -eq 36 ] && [[ "$v" =~ ^[0-9a-fA-F-]+$ ]] && [ "${v:14:1}" = "1" ]; then
        if snapctl unset session.secret; then
            lprint "session.secret: removed the generated v1 UUID; the app now keeps its own secret in ${SNAP_DATA}/.session-secret (one re-login)"
        fi
    fi
    : > "$marker" 2>/dev/null || true
    return 0
}

# Older revisions copied server.ssl into session.cookie-secure once at install, so turning
# HTTPS on later left cookies insecure. A stored value equal to server.ssl is that copy:
# drop it (once, marker) so the cookie follows HTTPS; a differing value was set on purpose.
function migrate_cookie_secure {
    local marker="${SNAP_COMMON}/.cookie-secure-migrated" ssl cookie
    [ -e "$marker" ] && return 0
    ssl="$(snapctl get server.ssl 2>/dev/null)"; cookie="$(snapctl get session.cookie-secure 2>/dev/null)"
    if [ -n "$ssl" ] && [ -n "$cookie" ] && [ "$ssl" = "$cookie" ]; then
        if snapctl unset session.cookie-secure; then
            lprint "session.cookie-secure: now follows server.ssl (was the install-time copy)"
        fi
    fi
    : > "$marker" 2>/dev/null || true
    return 0
}

function backup_dir {
    local d; d=$(snapctl get backup.dir 2>/dev/null)
    echo "${d:-$SNAP_DATA/backups}"
}

snap_version() { yq eval '.version' "$SNAP/meta/snap.yaml"; }

service_state() {              # "enabled active", "disabled inactive", or "unknown"
    local line
    line="$(snapctl services "$SNAP_NAME.$SNAP_NAME" 2>/dev/null | awk 'NR==2 { print $2 " " $3 }')"
    echo "${line:-unknown}"
}
