#!/usr/bin/env bash

export DAEMONIZED=1
source $SNAP/helper/functions
source $SNAP/helper/catalog

test_default_config
# Drop stored values this revision rejects (configure would fail and snapd would undo
# the refresh), then seed again so a dropped key with a default gets it back.
sanitize_config
test_default_config
migrate_session_secret
migrate_cookie_secure
test_device_priority_dir

# Update references to the external config directory
# Discussed with Al Calzone, lead dev of Zwavejs, can just be deleted and re-build
rm -f "${SNAP_DATA}/.ext-config/devices/index.json"
