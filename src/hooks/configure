#!/usr/bin/env bash
export DAEMONIZED=1
set -e
source $SNAP/helper/functions
source $SNAP/helper/catalog

# Seed before validating: seeding makes an unset key (snap unset, navigator reset) fall
# back to its default instead of staying empty.
test_default_config

for key in $(catalog_keys); do
    validate_config "${key}" "$(snapctl get "${key}")" || exit 1
done
validate_cross_config || exit 1

# A key the catalog does not know is a typo or a settings.json field: refuse it here, at
# snap set, with the fix. Only the key is printed, never the value.
bad="$(unknown_config_keys | head -n1)"
if [ -n "${bad}" ]; then
    echo "!! unknown setting \"${bad}\" — remove it with: sudo snap unset ${SNAP_NAME} ${bad}. Known settings: ${SNAP_NAME}.help" >&2
    case "${bad}" in mqtt.*) echo "MQTT broker settings live in settings.json — sudo ${SNAP_NAME}.ui → MQTT broker" >&2 ;; esac
    exit 1
fi

# Restart only when the running daemon's inputs changed. env-wrapper writes the digest
# of what the daemon started with; snapd runs this hook after start-snap-services on
# every refresh, so an equal digest (or a backup-only change) must not bounce the driver.
DIGEST_FILE="$(daemon_digest_file)"
if [ "$(daemon_config_digest)" != "$(cat "${DIGEST_FILE}" 2>/dev/null || true)" ]; then
    case "$(service_state)" in
        *" active") lprint "Restarting ${SNAP_NAME}.${SNAP_NAME}"; snapctl restart "${SNAP_NAME}.${SNAP_NAME}" ;;
    esac
fi
